# =============================================================================
# PLAGIARISM DETECTION SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# =============================================================================
# POSTGRESQL DATABASE (REQUIRED)
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/uyarai

# =============================================================================
# QDRANT VECTOR DATABASE (REQUIRED)
# =============================================================================
# Option 1: Local Qdrant (default)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_HTTPS=false

# Option 2: Qdrant Cloud
# QDRANT_HOST=your-cluster.qdrant.io
# QDRANT_PORT=6333
# QDRANT_API_KEY=your-api-key-here
# QDRANT_HTTPS=true

# =============================================================================
# WASABI S3 STORAGE (OPTIONAL)
# =============================================================================
# If not configured, figures are stored locally in ./data/figures/
# Wasabi is only needed for production with large corpus

# WASABI_ACCESS_KEY=your-access-key
# WASABI_SECRET_KEY=your-secret-key
# WASABI_BUCKET=uyar-plagiarism
# WASABI_REGION=us-east-1

# Alternative: Use AWS S3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_BUCKET=your-bucket
# AWS_REGION=us-east-1

# =============================================================================
# EMBEDDING MODEL (OPTIONAL)
# =============================================================================
# Default: BAAI/bge-large-en-v1.5 (downloaded automatically)
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# For offline use, set local path:
# EMBEDDING_MODEL_PATH=/path/to/local/model

# =============================================================================
# PROCESSING OPTIONS
# =============================================================================
# Use GPU for embeddings and image processing
USE_GPU=true

# Parallel workers for downloads and processing
MAX_WORKERS=4

# Batch size for embedding generation
BATCH_SIZE=32

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# DETECTION THRESHOLDS
# =============================================================================
# Text plagiarism thresholds
TEXT_EXACT_THRESHOLD=0.95
TEXT_HIGH_THRESHOLD=0.80
TEXT_MODERATE_THRESHOLD=0.50

# Image plagiarism thresholds
IMAGE_PHASH_THRESHOLD=10
IMAGE_CNN_THRESHOLD=0.85
IMAGE_COMBINED_THRESHOLD=0.75

# =============================================================================
# DATA DIRECTORIES
# =============================================================================
# Override default paths if needed
# DATA_DIR=./data
# MECA_DIR=./data/meca_files
# FIGURES_DIR=./data/figures
# INDEX_PATH=./data/biorxiv_index.json
# LOGS_DIR=./data/logs

# =============================================================================
# BIORXIV API (for index building)
# =============================================================================
# Rate limiting
BIORXIV_API_RATE_LIMIT=0.35

# =============================================================================
# OPTIONAL: CLIP MODEL FOR IMAGE EMBEDDINGS
# =============================================================================
# CLIP_MODEL=openai/clip-vit-base-patch32
# USE_CLIP=false
